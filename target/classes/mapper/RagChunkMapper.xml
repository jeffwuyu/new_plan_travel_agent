<?xml version="1.0" encoding="UTF-8"?>
<!-- 中文注释：MyBatis 映射文件，负责 rag_chunks 表相关 SQL 与字段映射定义。 -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travelagent.mapper.RagChunkMapper">

    <resultMap id="ragChunkResultMap" type="com.travelagent.model.entity.RagChunk">
        <id     property="id"            column="id"/>
        <result property="documentId"    column="document_id"/>
        <result property="chunkIndex"    column="chunk_index"/>
        <result property="chunkText"     column="chunk_text"/>
        <result property="dashvectorId"  column="dashvector_id"/>
        <result property="tokenCount"    column="token_count"/>
        <result property="createdAt"     column="created_at"/>
    </resultMap>

    <insert id="insertBatch" parameterType="java.util.List">
        INSERT INTO rag_chunks (document_id, chunk_index, chunk_text, dashvector_id,
                                token_count, created_at)
        VALUES
        <foreach collection="chunks" item="c" separator=",">
            (#{c.documentId}, #{c.chunkIndex}, #{c.chunkText}, #{c.dashvectorId},
             #{c.tokenCount}, NOW())
        </foreach>
    </insert>

    <select id="findByDocumentId" resultMap="ragChunkResultMap">
        SELECT * FROM rag_chunks
        WHERE document_id = #{documentId}
        ORDER BY chunk_index ASC
    </select>

    <select id="findByDashvectorId" resultMap="ragChunkResultMap">
        SELECT * FROM rag_chunks WHERE dashvector_id = #{dashvectorId} LIMIT 1
    </select>

    <delete id="deleteByDocumentId">
        DELETE FROM rag_chunks WHERE document_id = #{documentId}
    </delete>

</mapper>
