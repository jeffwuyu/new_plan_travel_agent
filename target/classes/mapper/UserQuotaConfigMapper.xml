<?xml version="1.0" encoding="UTF-8"?>
<!-- 中文注释：MyBatis 映射文件，负责 User Quota Config 相关 SQL 与字段映射定义。 -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travelagent.mapper.UserQuotaConfigMapper">

    <resultMap id="configResultMap" type="UserQuotaConfig">
        <id     property="id"                  column="id"/>
        <result property="userLevel"           column="user_level"/>
        <result property="dailyTokenLimit"     column="daily_token_limit"/>
        <result property="monthlyTokenLimit"   column="monthly_token_limit"/>
        <result property="maxConcurrentTasks"  column="max_concurrent_tasks"/>
        <result property="maxPlanSteps"        column="max_plan_steps"/>
        <result property="createdAt"           column="created_at"/>
        <result property="updatedAt"           column="updated_at"/>
    </resultMap>

    <select id="findByUserLevel" resultMap="configResultMap">
        SELECT * FROM user_quota_config WHERE user_level = #{userLevel} LIMIT 1
    </select>

    <update id="update" parameterType="UserQuotaConfig">
        UPDATE user_quota_config
        <set>
            <if test="dailyTokenLimit != null">daily_token_limit = #{dailyTokenLimit},</if>
            <if test="monthlyTokenLimit != null">monthly_token_limit = #{monthlyTokenLimit},</if>
            <if test="maxConcurrentTasks != null">max_concurrent_tasks = #{maxConcurrentTasks},</if>
            <if test="maxPlanSteps != null">max_plan_steps = #{maxPlanSteps},</if>
            updated_at = NOW()
        </set>
        WHERE user_level = #{userLevel}
    </update>

</mapper>
