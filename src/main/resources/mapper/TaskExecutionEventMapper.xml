<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travelagent.mapper.TaskExecutionEventMapper">

    <resultMap id="eventResultMap" type="com.travelagent.model.entity.TaskExecutionEvent">
        <id     property="id"          column="id"/>
        <result property="taskUuid"    column="task_uuid"/>
        <result property="eventType"   column="event_type"/>
        <result property="status"      column="status"/>
        <result property="stepIndex"   column="step_index"/>
        <result property="totalSteps"  column="total_steps"/>
        <result property="message"     column="message"/>
        <result property="detailsJson" column="details_json"/>
        <result property="createdAt"   column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.travelagent.model.entity.TaskExecutionEvent"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO task_execution_events
            (task_uuid, event_type, status, step_index, total_steps, message, details_json)
        VALUES
            (#{taskUuid}, #{eventType}, #{status}, #{stepIndex}, #{totalSteps},
             #{message}, #{detailsJson})
    </insert>

    <select id="findByTaskUuid" resultMap="eventResultMap">
        SELECT * FROM task_execution_events
        WHERE task_uuid = #{taskUuid}
        ORDER BY created_at ASC
        LIMIT #{limit}
    </select>

    <select id="findLatestByTaskUuid" resultMap="eventResultMap">
        SELECT * FROM task_execution_events
        WHERE task_uuid = #{taskUuid}
        ORDER BY created_at DESC
        LIMIT 1
    </select>

    <select id="countByTaskUuid" resultType="int">
        SELECT COUNT(*) FROM task_execution_events WHERE task_uuid = #{taskUuid}
    </select>

</mapper>
