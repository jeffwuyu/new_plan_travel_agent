<?xml version="1.0" encoding="UTF-8"?>
<!-- 中文注释：MyBatis 映射文件，负责 rag_documents 表相关 SQL 与字段映射定义。 -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travelagent.mapper.RagDocumentMapper">

    <resultMap id="ragDocumentResultMap" type="com.travelagent.model.entity.RagDocument">
        <id     property="id"           column="id"/>
        <result property="ossKey"       column="oss_key"/>
        <result property="title"        column="title"/>
        <result property="region"       column="region"/>
        <result property="docType"      column="doc_type"/>
        <result property="status"       column="status"/>
        <result property="errorMessage" column="error_message"/>
        <result property="createdAt"    column="created_at"/>
        <result property="updatedAt"    column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.travelagent.model.entity.RagDocument"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO rag_documents (oss_key, title, region, doc_type, status, error_message,
                                   created_at, updated_at)
        VALUES (#{ossKey}, #{title}, #{region}, #{docType}, #{status}, #{errorMessage},
                NOW(), NOW())
    </insert>

    <select id="findById" resultMap="ragDocumentResultMap">
        SELECT * FROM rag_documents WHERE id = #{id}
    </select>

    <select id="findByOssKey" resultMap="ragDocumentResultMap">
        SELECT * FROM rag_documents WHERE oss_key = #{ossKey} LIMIT 1
    </select>

    <update id="updateStatus">
        UPDATE rag_documents
        SET status        = #{status},
            error_message = #{errorMessage},
            updated_at    = NOW()
        WHERE id = #{id}
    </update>

    <select id="findByStatus" resultMap="ragDocumentResultMap">
        SELECT * FROM rag_documents WHERE status = #{status} ORDER BY created_at DESC
    </select>

    <delete id="deleteById">
        DELETE FROM rag_documents WHERE id = #{id}
    </delete>

    <select id="findAll" resultMap="ragDocumentResultMap">
        SELECT * FROM rag_documents ORDER BY created_at DESC
    </select>

</mapper>
