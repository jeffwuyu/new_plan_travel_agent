<?xml version="1.0" encoding="UTF-8"?>
<!-- 中文注释：MyBatis 映射文件，负责 User 相关 SQL 与字段映射定义。 -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travelagent.mapper.UserMapper">

    <resultMap id="userResultMap" type="User">
        <id     property="id"           column="id"/>
        <result property="username"     column="username"/>
        <result property="email"        column="email"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="userLevel"    column="user_level"/>
        <result property="status"       column="status"/>
        <result property="createdAt"    column="created_at"/>
        <result property="updatedAt"    column="updated_at"/>
        <result property="deletedAt"    column="deleted_at"/>
    </resultMap>

    <!-- Reusable soft-delete filter fragment -->
    <sql id="notDeleted">AND deleted_at IS NULL</sql>

    <insert id="insert" parameterType="User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (username, email, password_hash, user_level, status, created_at, updated_at)
        VALUES (#{username}, #{email}, #{passwordHash}, #{userLevel}, #{status},
                NOW(), NOW())
    </insert>

    <select id="findById" resultMap="userResultMap">
        SELECT * FROM users
        WHERE id = #{id} <include refid="notDeleted"/>
    </select>

    <select id="findByEmail" resultMap="userResultMap">
        SELECT * FROM users
        WHERE email = #{email} <include refid="notDeleted"/>
        LIMIT 1
    </select>

    <select id="findByUsername" resultMap="userResultMap">
        SELECT * FROM users
        WHERE username = #{username} <include refid="notDeleted"/>
        LIMIT 1
    </select>

    <update id="update" parameterType="User">
        UPDATE users
        <set>
            <if test="username != null">username = #{username},</if>
            <if test="userLevel != null">user_level = #{userLevel},</if>
            <if test="status != null">status = #{status},</if>
            updated_at = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <update id="softDelete">
        UPDATE users SET deleted_at = NOW(), updated_at = NOW()
        WHERE id = #{id} AND deleted_at IS NULL
    </update>

    <select id="existsByEmail" resultType="boolean">
        SELECT COUNT(*) > 0 FROM users
        WHERE email = #{email} AND deleted_at IS NULL
    </select>

    <select id="existsByUsername" resultType="boolean">
        SELECT COUNT(*) > 0 FROM users
        WHERE username = #{username} AND deleted_at IS NULL
    </select>

    <!--
        管理员分页查询：列出所有未软删除用户。
        配合 PageHelper 使用：调用前 PageHelper.startPage(page, size) 即可自动注入 LIMIT/OFFSET。
        按注册时间倒序，方便管理员查看最新注册用户。
    -->
    <select id="findAll" resultMap="userResultMap">
        SELECT * FROM users
        WHERE deleted_at IS NULL
        ORDER BY created_at DESC
    </select>

    <!--
        返回所有 status=1（正常）且未软删除的用户 ID 列表。
        供配额快照定时任务（QuotaServiceImpl.snapshotAllActiveUsers）批量使用，
        仅查 id 字段，避免加载不必要的密码哈希等敏感字段。
    -->
    <select id="findAllActiveIds" resultType="long">
        SELECT id FROM users
        WHERE status = 1 AND deleted_at IS NULL
    </select>

</mapper>
