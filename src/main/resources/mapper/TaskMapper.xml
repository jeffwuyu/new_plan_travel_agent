<?xml version="1.0" encoding="UTF-8"?>
<!-- 中文注释：MyBatis 映射文件，负责 Task 相关 SQL 与字段映射定义。 -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travelagent.mapper.TaskMapper">

    <resultMap id="taskResultMap" type="Task">
        <id     property="id"              column="id"/>
        <result property="taskUuid"        column="task_uuid"/>
        <result property="userId"          column="user_id"/>
        <result property="status"          column="status"/>
        <result property="region"          column="region"/>
        <result property="checkpointJson"  column="checkpoint_json"/>
        <result property="schemaVersion"   column="schema_version"/>
        <result property="totalTokensUsed" column="total_tokens_used"/>
        <result property="errorMessage"    column="error_message"/>
        <result property="createdAt"       column="created_at"/>
        <result property="updatedAt"       column="updated_at"/>
        <result property="completedAt"     column="completed_at"/>
    </resultMap>

    <insert id="insert" parameterType="Task" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tasks (task_uuid, user_id, status, region, schema_version, total_tokens_used,
                           created_at, updated_at)
        VALUES (#{taskUuid}, #{userId}, #{status}, #{region}, #{schemaVersion}, 0,
                NOW(), NOW())
    </insert>

    <select id="findByUuid" resultMap="taskResultMap">
        SELECT * FROM tasks WHERE task_uuid = #{taskUuid} LIMIT 1
    </select>

    <select id="findById" resultMap="taskResultMap">
        SELECT * FROM tasks WHERE id = #{id} LIMIT 1
    </select>

    <select id="findByUserId" resultMap="taskResultMap">
        SELECT * FROM tasks WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <select id="findByStatus" resultMap="taskResultMap">
        SELECT * FROM tasks WHERE status = #{status}
        ORDER BY created_at ASC
        LIMIT #{limit}
    </select>

    <!--
        Startup recovery scan: find tasks stuck in mid-execution states (planning, tool_calling)
        after a JVM crash. Only called once at application startup by AgentServiceImpl@PostConstruct.
        LIMIT guards against a full-table scan on a large backlog.
    -->
    <select id="findByStatusIn" resultMap="taskResultMap">
        SELECT * FROM tasks
        WHERE status IN
        <foreach collection="statuses" item="s" open="(" separator="," close=")">
            #{s}
        </foreach>
        ORDER BY created_at ASC
        LIMIT #{limit}
    </select>

    <!--
        Admin cross-status paginated query.
        checkpoint_json intentionally excluded (MEDIUMTEXT, not needed in admin view).
        PageHelper injects LIMIT/OFFSET automatically.
    -->
    <select id="findAllWithFilter" resultMap="taskResultMap">
        SELECT id, task_uuid, user_id, status, region,
               schema_version, total_tokens_used, error_message,
               created_at, updated_at, completed_at
        FROM tasks
        <where>
            <if test="status != null and status != ''">
                status = #{status}
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

    <!-- Count tasks in active states (for concurrency limit enforcement) -->
    <select id="countActiveByUserId" resultType="int">
        SELECT COUNT(*) FROM tasks
        WHERE user_id = #{userId}
          AND status IN ('pending', 'planning', 'tool_calling', 'awaiting_user_input', 'resuming')
    </select>

    <update id="updateStatus">
        UPDATE tasks SET status = #{status}, updated_at = NOW()
        <if test="status == 'completed' or status == 'failed' or status == 'cancelled'">
            , completed_at = NOW()
        </if>
        WHERE id = #{id}
    </update>

    <update id="updateCheckpoint" parameterType="Task">
        UPDATE tasks
        SET checkpoint_json  = #{checkpointJson},
            status           = #{status},
            total_tokens_used = #{totalTokensUsed},
            updated_at       = NOW()
        WHERE id = #{id}
    </update>

    <update id="update" parameterType="Task">
        UPDATE tasks
        <set>
            <if test="status != null">status = #{status},</if>
            <if test="checkpointJson != null">checkpoint_json = #{checkpointJson},</if>
            <if test="totalTokensUsed != null">total_tokens_used = #{totalTokensUsed},</if>
            <if test="errorMessage != null">error_message = #{errorMessage},</if>
            updated_at = NOW()
        </set>
        WHERE id = #{id}
    </update>

</mapper>
