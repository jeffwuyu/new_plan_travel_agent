<?xml version="1.0" encoding="UTF-8"?>
<!-- 用途：用户配额用量快照 MyBatis 映射文件。
     定时快照逻辑（QuotaServiceImpl）将 Redis 计数器以 UPSERT 方式同步到此表，
     以支持 Redis 重启后的配额恢复和历史用量审计。 -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.travelagent.mapper.UserQuotaUsageMapper">

    <!-- 字段映射 -->
    <resultMap id="usageResultMap" type="UserQuotaUsage">
        <id     property="id"          column="id"/>
        <result property="userId"      column="user_id"/>
        <result property="periodType"  column="period_type"/>
        <result property="periodKey"   column="period_key"/>
        <result property="tokensUsed"  column="tokens_used"/>
        <result property="updatedAt"   column="updated_at"/>
    </resultMap>

    <!--
        UPSERT：唯一键 (user_id, period_type, period_key)。
        若记录已存在则用最新 tokens_used 覆盖；不存在则插入新行。
        ON DUPLICATE KEY UPDATE 保证原子性，多实例调度同时写入不会产生重复行。
    -->
    <insert id="upsert" parameterType="UserQuotaUsage">
        INSERT INTO user_quota_usage (user_id, period_type, period_key, tokens_used, updated_at)
        VALUES (#{userId}, #{periodType}, #{periodKey}, #{tokensUsed}, NOW())
        ON DUPLICATE KEY UPDATE
            tokens_used = #{tokensUsed},
            updated_at  = NOW()
    </insert>

    <!-- 查询特定用户、周期类型、周期标识的快照记录 -->
    <select id="findByUserAndPeriod" resultMap="usageResultMap">
        SELECT * FROM user_quota_usage
        WHERE user_id    = #{userId}
          AND period_type = #{periodType}
          AND period_key  = #{periodKey}
        LIMIT 1
    </select>

    <!-- 查询某用户全部快照记录（管理员审计），按最近更新时间倒序 -->
    <select id="findByUserId" resultMap="usageResultMap">
        SELECT * FROM user_quota_usage
        WHERE user_id = #{userId}
        ORDER BY updated_at DESC
    </select>

</mapper>
